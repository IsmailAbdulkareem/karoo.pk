# Frontend Environment Variables

# API Configuration - LOCAL DEVELOPMENT
# ✅ For web browser / emulator on same computer:
EXPO_PUBLIC_API_URL=http://localhost:8000

# 📱 For testing on physical phone via Expo Go, find your computer's IP and use:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-cloud-api-key
